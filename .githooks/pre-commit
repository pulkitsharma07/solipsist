#!/bin/sh
# Before every commit: no secret in what's staged (gitleaks), then the fast unit tests (`bun run test:fast`, about
# 20 s). Git uses this folder because `bun install` sets `core.hooksPath` (package.json `prepare`).
# When it fails, fix what it found: `--no-verify` is not a way past it (AGENTS.md).
set -e

if command -v gitleaks >/dev/null 2>&1; then
  gitleaks git --pre-commit --staged --redact --no-banner
else
  echo "pre-commit: gitleaks isn't installed (brew install gitleaks), so nothing was scanned and the commit stopped" >&2
  exit 1
fi

# Git hands a hook its pointers to this repo (in a worktree, GIT_DIR too). The tests run git in scratch folders, and
# with these set it would answer for this checkout from any of them.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_COMMON_DIR GIT_OBJECT_DIRECTORY GIT_PREFIX
bun run test:fast
