# Copy to `.env` (git ignores that file) and change what you need. Bun loads `.env` by itself.
# In a git worktree: `cp .env.example .env`, then pick a PORT no other worktree uses.
#
# Settings live in solipsist.yaml (see solipsist.example.yaml); every one can also be set here by its environment
# name, which wins over the file. CONFIGURATION.md lists them all. Keep this file for the port and the secrets.

# The port of the dev server (bun run dev). Default 3000.
PORT=3000

# Which .md files Solipsist offers is set by md_search_paths in solipsist.yaml.

# The Pi agent engine (the default): an OpenRouter key. Not needed if `pi` already has a login of its own
# (`pi`, then `/login`), which Solipsist uses as the CLI would; a key set here is used instead of it.
# With neither, Pi is listed but greyed out.
# SOLIPSIST_OPENROUTER_KEY=sk-or-...

