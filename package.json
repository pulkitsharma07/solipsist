  "version": "0.2.1",
  "type": "module",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "dev": "NODE_ENV=development bun --hot src/index.ts",
    "start": "NODE_ENV=production bun src/index.ts",
    "test": "bun test",
    "test:fast": "bun scripts/test-fast.ts",
    "test:ui": "bun test ./test/e2e/smoke.e2e.ts ./test/e2e/chat.e2e.ts ./test/e2e/pi.e2e.ts",
    "typecheck": "bun --bun tsc --noEmit",
    "features": "bun scripts/features/index.tsx",
    "build": "bun scripts/build.ts",
    "release": "bun scripts/release.ts",
    "site": "bun scripts/site/build.ts",
    "site:shots": "bun scripts/site/shots.ts",
    "site:og": "bun scripts/site/og.ts",
    "site:demo": "bun scripts/site/demo-gif.ts",
    "random-edits": "bun scripts/random-edits.ts"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@tiptap/core": "3.32.0",
    "@tiptap/extension-code": "3.32.0",
    "@tiptap/extension-code-block": "3.32.0",
    "@tiptap/extension-image": "3.32.0",
    "@tiptap/extension-link": "3.32.0",
    "@tiptap/extension-list": "3.32.0",
    "@tiptap/extension-paragraph": "3.32.0",
    "@tiptap/extension-placeholder": "3.32.0",
    "@tiptap/extension-table": "3.32.0",
    "@tiptap/markdown": "3.32.0",
    "@tiptap/pm": "3.32.0",
    "@tiptap/react": "3.32.0",
    "@tiptap/starter-kit": "3.32.0",
    "bun-plugin-tailwind": "^0.1.2",
    "node-diff3": "^3.2.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.0",
    "tailwindcss": "^4.3.3",
    "yaml": "^2.9.1"
